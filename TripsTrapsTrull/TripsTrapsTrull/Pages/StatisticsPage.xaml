<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TripsTrapsTrull.Pages.StatisticsPage"
    Title="Statistika">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="15">

            <Label
                Text="Statistika"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="Black" />

            <Frame
                BackgroundColor="LightGray"
                CornerRadius="10"
                Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label
                        x:Name="GamesLabel"
                        FontSize="20"
                        TextColor="Black" />

                    <Label
                        x:Name="XWinsLabel"
                        FontSize="20"
                        TextColor="Red" />

                    <Label
                        x:Name="OWinsLabel"
                        FontSize="20"
                        TextColor="Blue" />

                    <Label
                        x:Name="DrawsLabel"
                        FontSize="20"
                        TextColor="DarkOrange" />

                </VerticalStackLayout>

            </Frame>

            <Button
                Text="Kustuta statistika"
                HeightRequest="55"
                FontSize="18"
                BackgroundColor="Red"
                TextColor="White"
                CornerRadius="10"
                Clicked="ResetStatistics_Clicked" />

            <Button
                Text="Tagasi mängu"
                HeightRequest="55"
                FontSize="18"
                BackgroundColor="DarkBlue"
                TextColor="White"
                CornerRadius="10"
                Clicked="Back_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
